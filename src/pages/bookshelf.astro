---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="My Library" description="Explore the books I’ve read on an interactive bookshelf.">
	<main class="library-page" aria-label="My Library">
		<iframe src="/library/index.html" title="Interactive bookshelf"></iframe>
	</main>
</BaseLayout>

<style>
	:global(body:has(.library-page)) {
		display: flex;
		flex-direction: column;
		height: 100dvh;
		min-height: 26rem;
	}

	:global(body:has(.library-page) > .site-footer) {
		padding-block: 0.45rem;
	}

	.library-page {
		flex: 1;
		min-height: 0;
		display: flex;
	}

	iframe {
		display: block;
		width: 100%;
		border: 0;
	}
</style>
